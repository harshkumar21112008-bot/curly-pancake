# Storage: leave empty for local SQLite, or use a Supabase/Postgres connection string (pooler URL on port 6543)
DATABASE_URL=

# Keyword volume provider (pick one). DATAFORSEO_BASE=https://sandbox.dataforseo.com uses free dummy data.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE=https://api.dataforseo.com
KEYWORDS_EVERYWHERE_KEY=

# Alerts (both optional; the UI can also take a webhook/email per run)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: re-check every tracked domain on a schedule
AUTO_CHECK_HOURS=
